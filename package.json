{
  "name": "lucid-search",
  "version": "2.0.0",
  "description": "Find literal matches with positions in text; built for AI agents and search-as-you-type",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "llms.txt"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "test": "node --test",
    "verify": "node --test && fallow"
  },
  "homepage": "https://github.com/niekes/lucid-search",
  "repository": {
    "type": "git",
    "url": "https://github.com/niekes/lucid-search"
  },
  "bugs": {
    "url": "https://github.com/niekes/lucid-search/issues"
  },
  "keywords": [
    "search",
    "highlight",
    "match",
    "special characters",
    "ai",
    "agent",
    "llm"
  ],
  "author": "Stefan Nieke",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "fallow": "^3.43.0"
  }
}
