{
    "name": "lucid-search",
    "version": "2.2.0",
    "description": "Find matches in text and get ranges and segments to highlight them safely, with accent-insensitive matching",
    "keywords": [
        "diacritics",
        "highlight",
        "match",
        "ranges",
        "react",
        "search",
        "special characters"
    ],
    "homepage": "https://niekes.github.io/lucid-search/",
    "bugs": {
        "url": "https://github.com/niekes/lucid-search/issues"
    },
    "license": "BSD-3-Clause",
    "author": "Stefan Nieke",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/niekes/lucid-search.git"
    },
    "files": [
        "build/lucid-search.js",
        "build/lucid-search.es.js",
        "build/lucid-search.cjs",
        "build/**/*.d.ts",
        "build/**/*.d.cts",
        "llms.txt"
    ],
    "type": "module",
    "main": "build/lucid-search.cjs",
    "module": "build/lucid-search.es.js",
    "types": "build/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./build/index.d.ts",
                "default": "./build/lucid-search.es.js"
            },
            "require": {
                "types": "./build/index.d.cts",
                "default": "./build/lucid-search.cjs"
            }
        }
    },
    "scripts": {
        "clean": "rm -rf build",
        "typecheck": "tsc --noEmit",
        "build": "pnpm clean && pnpm typecheck && vp pack",
        "check": "vp check",
        "test": "vp test run",
        "test:watch": "vp test",
        "bench": "vp test bench --run",
        "coverage": "vp test run --coverage",
        "docs:dev": "vitepress dev docs",
        "docs:build": "vitepress build docs",
        "docs:preview": "vitepress preview docs",
        "lint:fallow": "fallow dead-code --ci --format ${FALLOW_FORMAT:-human} && fallow health --ci --coverage-gaps --format ${FALLOW_FORMAT:-human} && fallow dupes --ci --format ${FALLOW_FORMAT:-human}",
        "verify": "pnpm typecheck && pnpm check && pnpm coverage && pnpm lint:fallow && pnpm build && pnpm docs:build",
        "hooks:install": "fallow hooks install --target git && fallow hooks install --target agent --agent claude && fallow hooks install --target agent --agent codex",
        "prepack": "pnpm build"
    },
    "devDependencies": {
        "@leeoniya/ufuzzy": "1.0.19",
        "@vitest/coverage-v8": "5.0.5",
        "fallow": "3.34.1",
        "fuse.js": "7.5.0",
        "fuzzysort": "4.0.2",
        "typescript": "^7.0.2",
        "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
        "vite-plus": "1.3.0",
        "vitepress": "2.0.0-alpha.21",
        "vitest": "5.0.5",
        "vue": "^3.5.45"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "^22.18.0 || ^24.11.0 || >=26.0.0"
        }
    },
    "packageManager": "pnpm@12.21.0"
}
