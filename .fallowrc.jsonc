{
    "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",

    // The public entry point of the package, plus the docs site and the
    // benchmarks, which reach the library through the public API only.
    "entry": [
        "index.ts",
        "docs/.vitepress/config.ts",
        "docs/.vitepress/theme/index.ts",
        "bench/**/*.bench.ts",
        "bench/browser.ts",
        "bench/size.ts"
    ],

    // The docs site and the benchmarks never ship, so they may use these
    // devDependencies. The shipped package (index.ts, src/) imports nothing.
    // mark.js is loaded into the browser benchmark by path, not imported.
    "ignoreDependencies": [
        "vue",
        "vite-plus",
        "highlight-words-core",
        "highlight-words",
        "spotmark",
        "accent-folding",
        "mark.js"
    ],

    // Every rule that can catch a violation of the architecture is an error.
    "rules": {
        "unused-files": "error",
        "unused-exports": "error",
        "unused-types": "error",
        "unused-class-members": "error",
        "private-type-leaks": "error",
        "unresolved-imports": "error",
        "unlisted-dependencies": "error",
        "duplicate-exports": "error",
        "circular-dependencies": "error",
        "re-export-cycle": "error",
        "boundary-violation": "error",
        "coverage-gaps": "error",
        "stale-suppressions": "error"
    },

    //   index.ts   public-api  ->  core
    //   src/*      core        ->  core
    //   tests/*    tests       ->  public-api (core only through it)
    //   docs/*     docs        ->  public-api (core only through it)
    //   bench/*    bench       ->  public-api (core only through it)
    //
    // Fallow follows the re-exports of index.ts, so tests and docs must be
    // allowed to reach core. They still import from index.ts only: a test
    // that imports src/ directly leaves the public export untested, which
    // the coverage-gaps rule reports.
    "boundaries": {
        "zones": [
            { "name": "public-api", "patterns": ["index.ts"] },
            { "name": "core", "patterns": ["src/**/*.ts"] },
            { "name": "tests", "patterns": ["tests/**"] },
            { "name": "docs", "patterns": ["docs/**"] },
            { "name": "bench", "patterns": ["bench/**"] }
        ],
        "rules": [
            { "from": "public-api", "allow": ["core"] },
            { "from": "core", "allow": ["core"] },
            { "from": "tests", "allow": ["public-api", "core"] },
            { "from": "docs", "allow": ["public-api", "core"] },
            { "from": "bench", "allow": ["public-api", "core", "bench"] }
        ],
        "coverage": {
            "requireAllFiles": true,
            "allowUnmatched": ["vite.config.ts"]
        },
        "calls": {
            "forbidden": [{ "from": "core", "callee": ["console.*", "debugger"] }]
        }
    },
    // Every file in the package is new in v2, so there is no inherited debt to
    // exempt: a finding anywhere in a changed file fails the audit.
    "audit": { "gate": "all" },
    "health": {
        "ignore": ["tests/**", "docs/**", "bench/**"]
    }
}
