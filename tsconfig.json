{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ES2020",
        "lib": ["ES2020", "DOM"],
        "strict": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "moduleResolution": "bundler",
        "isolatedDeclarations": true,
        "declaration": true,
        "noEmit": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true,
        "types": ["vitest/globals"]
    },
    "include": [
        "index.ts",
        "src/**/*",
        "tests/**/*",
        "bench/**/*",
        "docs/.vitepress/**/*.ts",
        "vite.config.ts"
    ],
    "exclude": ["node_modules", "build", "docs/.vitepress/cache", "docs/.vitepress/dist"]
}
